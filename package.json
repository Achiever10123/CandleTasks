{
  "name": "candletasks",
  "version": "1.1.2",
  "description": "A cozy sticky-note todo app with daily streaks",
  "author": "CandleTasks contributors",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --win --x64 --publish never",
    "build:portable": "electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "com.candletasks.app",
    "productName": "CandleTasks",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Achiever10123",
        "repo": "CandleTasks"
      }
    ],
    "files": [
      "package.json",
  "main.js",
  "preload.js",
  "updater.js",
  "index.html",
  "style.css",
  "app.js",
  "nlp.js",
  "streak-rules.js",
  "quick.html",
  "quick.js",
  "icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CandleTasks",
      "artifactName": "CandleTasks-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CandleTasks-portable.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
